.CODE
PUSH lbl_main@Init
CALL

HALT

simple_heap_init: RET 0

simple_malloc: 
LOADFP
LOADSP
STOREFP
LOADHL
DUP
PUSH 1
ADD
STORE 4
LOAD 3
ADD
STOREHL
STOREFP
RET 1
.DATA
VT@Object: NOP

.CODE
lbl_debugPrint@Object: LOADFP #Apila el valor del registro fp
LOADSP
STOREFP
LOAD 3
IPRINT
STOREFP #Apila el valor del registro sp
RET 1

lbl_constructor@Object: NOP
.DATA
