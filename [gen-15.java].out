.CODE
lbl_main@Init: LOADFP
LOADSP
STOREFP
RMEM 1
PUSH 1
STORE 0
PUSH 1000
PUSH 1
LT
BF lbl_else@7
LOAD 0
PUSH lbl_debugPrint@Object
CALL
JUMP lbl_fin_if@7
lbl_else@7: NOP
PUSH 20
PUSH lbl_debugPrint@Object
